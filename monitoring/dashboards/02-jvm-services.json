{
  "uid": "jvm-services",
  "title": "☕ JVM & Microservices",
  "description": "Métriques JVM détaillées par service — mémoire heap/non-heap, GC, threads, connexions",
  "tags": ["jvm", "java", "microservices"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [{
      "name": "service",
      "label": "Service",
      "type": "query",
      "query": "label_values(jvm_memory_used_bytes, job)",
      "current": {},
      "includeAll": true,
      "allValue": ".*",
      "multi": true,
      "refresh": 2
    }]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "JVM Heap Utilisé",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 256000000}, {"color": "red", "value": 512000000}]}
        }
      },
      "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"heap\", job=~\"$service\"})", "legendFormat": "Heap", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "JVM Non-Heap",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 150000000}, {"color": "red", "value": 300000000}]}
        }
      },
      "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"nonheap\", job=~\"$service\"})", "legendFormat": "Non-Heap", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Threads Actifs",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 50}, {"color": "red", "value": 100}]}
        }
      },
      "targets": [{"expr": "sum(jvm_threads_live_threads{job=~\"$service\"})", "legendFormat": "Threads", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "GC Pause Totale",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}
        }
      },
      "targets": [{"expr": "sum(jvm_gc_pause_seconds_sum{job=~\"$service\"})", "legendFormat": "GC Pause", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "📊 Mémoire Heap par Service",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 9},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 2, "fillOpacity": 15, "spanNulls": true}
        }
      },
      "targets": [
        {"expr": "jvm_memory_used_bytes{area=\"heap\", job=~\"$service\"}", "legendFormat": "{{job}} - heap used", "refId": "A"},
        {"expr": "jvm_memory_committed_bytes{area=\"heap\", job=~\"$service\"}", "legendFormat": "{{job}} - heap committed", "refId": "B"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "🔄 Garbage Collection — Fréquence",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 9},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "sum"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "targets": [
        {"expr": "rate(jvm_gc_pause_seconds_count{job=~\"$service\"}[1m])", "legendFormat": "{{job}} - {{action}} {{cause}}", "refId": "A"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "🧵 Threads par État",
      "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "targets": [
        {"expr": "jvm_threads_live_threads{job=~\"$service\"}", "legendFormat": "{{job}} - live", "refId": "A"},
        {"expr": "jvm_threads_daemon_threads{job=~\"$service\"}", "legendFormat": "{{job}} - daemon", "refId": "B"},
        {"expr": "jvm_threads_peak_threads{job=~\"$service\"}", "legendFormat": "{{job}} - peak", "refId": "C"}
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "⚙️ CPU Usage par Service",
      "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"lineWidth": 2, "fillOpacity": 15}
        }
      },
      "targets": [
        {"expr": "process_cpu_usage{job=~\"$service\"}", "legendFormat": "{{job}} - process CPU", "refId": "A"},
        {"expr": "system_cpu_usage{job=~\"$service\"}", "legendFormat": "{{job}} - system CPU", "refId": "B"}
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "🗄️ Pool de Connexions DB (HikariCP)",
      "gridPos": {"x": 0, "y": 21, "w": 12, "h": 8},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "targets": [
        {"expr": "hikaricp_connections_active{job=~\"$service\"}", "legendFormat": "{{job}} - actives", "refId": "A"},
        {"expr": "hikaricp_connections_idle{job=~\"$service\"}", "legendFormat": "{{job}} - idle", "refId": "B"},
        {"expr": "hikaricp_connections_pending{job=~\"$service\"}", "legendFormat": "{{job}} - en attente", "refId": "C"},
        {"expr": "hikaricp_connections_max{job=~\"$service\"}", "legendFormat": "{{job}} - max", "refId": "D"}
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "⏱️ Uptime des Services",
      "gridPos": {"x": 12, "y": 21, "w": 12, "h": 8},
      "options": {"tooltip": {"mode": "single"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {"expr": "process_uptime_seconds{job=~\"$service\"}", "legendFormat": "{{job}}", "refId": "A"}
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
