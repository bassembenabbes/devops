{
  "uid": "infra-databases",
  "title": "🏗️ Infrastructure & Bases de Données",
  "description": "Kubernetes pods, MongoDB, Redis, PostgreSQL — métriques système et état des données",
  "tags": ["infrastructure", "kubernetes", "database"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pods Running",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 3}, {"color": "green", "value": 5}]}
        }
      },
      "targets": [{"expr": "count(kube_pod_status_phase{phase=\"Running\", namespace=\"ecommerce\"})", "legendFormat": "Pods UP", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pods en Erreur",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}
        }
      },
      "targets": [{"expr": "count(kube_pod_status_phase{phase=~\"Failed|Unknown\", namespace=\"ecommerce\"}) or vector(0)", "legendFormat": "Erreurs", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connexions Redis",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 50}, {"color": "red", "value": 100}]}
        }
      },
      "targets": [{"expr": "redis_connected_clients", "legendFormat": "Clients Redis", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Redis Mémoire",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 100000000}, {"color": "red", "value": 200000000}]}
        }
      },
      "targets": [{"expr": "redis_memory_used_bytes", "legendFormat": "RAM Redis", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Redis Hit Rate",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.5}, {"color": "green", "value": 0.8}]}
        }
      },
      "targets": [{"expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))", "legendFormat": "Hit Rate", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Targets Prometheus",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}
        }
      },
      "targets": [{"expr": "count(up == 1)", "legendFormat": "Targets UP", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "🐳 CPU par Container (Kubernetes)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 9},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "targets": [
        {"expr": "rate(container_cpu_usage_seconds_total{namespace=\"ecommerce\", container!=\"\", container!=\"POD\"}[1m])", "legendFormat": "{{container}}", "refId": "A"},
        {"expr": "rate(container_cpu_usage_seconds_total{namespace=\"keycloak\", container!=\"\", container!=\"POD\"}[1m])", "legendFormat": "keycloak/{{container}}", "refId": "B"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "💾 RAM par Container (Kubernetes)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 9},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "targets": [
        {"expr": "container_memory_working_set_bytes{namespace=\"ecommerce\", container!=\"\", container!=\"POD\"}", "legendFormat": "{{container}}", "refId": "A"},
        {"expr": "container_memory_working_set_bytes{namespace=\"keycloak\", container!=\"\", container!=\"POD\"}", "legendFormat": "keycloak/{{container}}", "refId": "B"}
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "⚡ Redis — Opérations/sec",
      "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "targets": [
        {"expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "Commandes/s", "refId": "A"},
        {"expr": "rate(redis_keyspace_hits_total[1m])", "legendFormat": "Cache Hits/s", "refId": "B"},
        {"expr": "rate(redis_keyspace_misses_total[1m])", "legendFormat": "Cache Misses/s", "refId": "C"}
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "🌐 Réseau I/O Kubernetes",
      "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "targets": [
        {"expr": "sum(rate(container_network_receive_bytes_total{namespace=\"ecommerce\"}[1m]))", "legendFormat": "↓ Reçu ecommerce", "refId": "A"},
        {"expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"ecommerce\"}[1m]))", "legendFormat": "↑ Envoyé ecommerce", "refId": "B"}
      ]
    },
    {
      "id": 30,
      "type": "table",
      "title": "📋 État des Pods — Tous Namespaces",
      "gridPos": {"x": 0, "y": 21, "w": 24, "h": 8},
      "options": {
        "sortBy": [{"displayName": "namespace"}],
        "footer": {"show": true, "reducer": ["count"], "fields": ["Value"]}
      },
      "fieldConfig": {
        "defaults": {"custom": {"align": "left", "minWidth": 100}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {"id": "displayName", "value": "Status"},
              {"id": "mappings", "value": [
                {"type": "value", "options": {
                  "1": {"text": "✅ Running", "color": "green"},
                  "0": {"text": "❌ Stopped", "color": "red"}
                }}
              ]},
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "custom.width", "value": 140}
            ]
          }
        ]
      },
      "targets": [{
        "expr": "kube_pod_status_ready",
        "legendFormat": "{{namespace}} / {{pod}}",
        "refId": "A",
        "instant": true,
        "format": "table"
      }]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
